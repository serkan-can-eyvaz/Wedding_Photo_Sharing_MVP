# Copy to infrastructure/.env.production on the VPS. Keep secret and TLS-path
# placeholders private, and use this canonical public domain configuration.
APP_DOMAIN=xn--aramzdan-wkb.com
TLS_CERT_DIR=<absolute-path-to-untracked-tls-directory>

POSTGRES_DB=<production-database-name>
POSTGRES_USER=<production-database-user>
POSTGRES_PASSWORD=<production-database-password>

# Used only to create the first admin when the users table is empty. Changes after bootstrap do not modify or create admin accounts.
ADMIN_EMAIL=<initial-admin-email>
ADMIN_PASSWORD=<initial-admin-password>
JWT_SECRET=<at-least-32-byte-high-entropy-random-secret>

CORS_ALLOWED_ORIGIN=https://xn--aramzdan-wkb.com
APP_PUBLIC_BASE_URL=https://xn--aramzdan-wkb.com
VITE_API_BASE_URL=https://xn--aramzdan-wkb.com

R2_ENDPOINT=<cloudflare-r2-s3-endpoint>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<private-r2-bucket-name>
