# Local Docker Compose ports and PostgreSQL
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=wedding_share
POSTGRES_USER=wedding_share
POSTGRES_PASSWORD=change-me-local-postgres-password

# Direct backend runs only; Docker Compose builds its DB URL with the db hostname.
DB_URL=jdbc:postgresql://localhost:5432/wedding_share
DB_USERNAME=wedding_share
DB_PASSWORD=change-me-local-postgres-password

# Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=https://example.invalid
R2_ACCESS_KEY_ID=local-placeholder-access-key
R2_SECRET_ACCESS_KEY=local-placeholder-secret-key
R2_BUCKET=local-placeholder-bucket

# Application
VITE_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-local-admin-password
JWT_SECRET=local-development-only-jwt-secret-at-least-32-characters

# CI/CD and deployment
REGISTRY_USERNAME=
REGISTRY_TOKEN=
DEPLOY_HOST=
DEPLOY_USER=
